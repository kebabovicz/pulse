{
  "name": "pulse",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @pulse/shared && npm run build -w @pulse/server && npm run build -w @pulse/web",
    "dev": "concurrently -n server,web \"npm run dev -w @pulse/server\" \"npm run dev -w @pulse/web\"",
    "typecheck": "npm run typecheck -ws --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint packages"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.68.0"
  }
}
